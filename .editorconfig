root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,json,yml,yaml,css}]
indent_size = 2

[*.php]
indent_size = 4

# Nas views o HTML domina, e 2 espaços mantêm o aninhamento legível.
[src/Views/**.php]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

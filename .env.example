# =============================================================================
# Valorant StratHub — exemplo de configuração
#
# Copie para `.env` e preencha. O arquivo `.env` NUNCA deve ser versionado.
#   cp .env.example .env
#
# Gere um APP_SECRET novo e único com:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# =============================================================================

# -- Aplicação ----------------------------------------------------------------
# local | production
APP_ENV=local

# Segredo usado para assinar/derivar tokens. Obrigatório em produção.
# A aplicação se recusa a subir em produção sem um valor com 32+ caracteres.
APP_SECRET=

# Controla logs verbosos no servidor. Sempre 'false' em produção.
APP_DEBUG=false

# -- Banco de dados -----------------------------------------------------------
# 'true' usa SQLite local (não precisa de Supabase, ideal para rodar offline).
USE_SQLITE=true

# Usados apenas quando USE_SQLITE=false
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# -- Armazenamento de mídia ---------------------------------------------------
# local    grava em public/uploads (funciona sem conta externa; ideal para rodar
#          o projeto pela primeira vez, mas não serve para hospedagem serverless,
#          onde o disco é efêmero)
# supabase envia para o Supabase Storage
# Se ficar vazio, o driver é escolhido automaticamente: supabase quando houver
# credenciais abaixo, local caso contrário.
STORAGE_DRIVER=local

# -- Supabase Storage ---------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Chave pública — pode aparecer no cliente, protegida por RLS.
SUPABASE_ANON_KEY=

# Chave administrativa — IGNORA RLS. Trate como senha de root:
# nunca commite, nunca exponha no frontend, rotacione se vazar.
SUPABASE_SERVICE_KEY=
